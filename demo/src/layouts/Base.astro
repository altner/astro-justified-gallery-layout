---
import Lightbox from "@altner/astro-justified-gallery-layout/Lightbox.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <strong>astro-justified-gallery-layout</strong>
      <nav>
        <a href="/" aria-current={path === "/" ? "page" : undefined}>Demo</a>
        <a href="/playground" aria-current={path === "/playground" ? "page" : undefined}>Playground</a>
        <a href="/virtual" aria-current={path === "/virtual" ? "page" : undefined}>Virtual</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <Lightbox />

    <style is:global>
      :root {
        color-scheme: light dark;
        --fg: #111;
        --muted: #666;
        --bg: #fff;
        --border: #e5e5e5;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #f0f0f0;
          --muted: #aaa;
          --bg: #111;
          --border: #2a2a2a;
        }
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
        font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      }
      a { color: inherit; }
      .site-header {
        display: flex;
        gap: 1.5rem;
        align-items: center;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        background: var(--bg);
        z-index: 10;
      }
      .site-header nav {
        display: flex;
        gap: 1rem;
        margin-left: auto;
      }
      .site-header nav a {
        text-decoration: none;
        color: var(--muted);
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
      }
      .site-header nav a[aria-current="page"] {
        color: var(--fg);
        background: var(--border);
      }
      main {
        padding: 1.5rem;
        max-width: 1400px;
        margin: 0 auto;
      }
      h1 { margin-top: 0; }
      h2 { margin-top: 2.5rem; }
      .meta { color: var(--muted); font-size: 0.875rem; }
    </style>
  </body>
</html>
