---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface GalleryImage {
  src: ImageMetadata;
  alt?: string;
  /**
   * Optional caption HTML rendered as a hover-revealed overlay on the item.
   * Trusted source assumed — content is set via `set:html` and is **not**
   * sanitized. Use only with metadata you control (your own EXIF/IPTC).
   */
  caption?: string;
  /**
   * Optional href; if set, the item becomes a clickable link wrapping the
   * image and caption.
   */
  href?: string;
  /**
   * Optional tiny LQIP preview (typically a `data:image/webp;base64,...` URI).
   * Stored on the `<img>` as `data-preview`; `<Lightbox />` uses it for
   * instant first paint.
   */
  preview?: string;
}

export interface Props {
  images: GalleryImage[];
  targetRowHeight?: number;
  gap?: number;
  maxRowHeight?: number;
  /**
   * If set, only this many items are laid out + visible initially. More are
   * revealed as the user scrolls (IntersectionObserver). Without this prop,
   * all items render at once.
   */
  chunkSize?: number;
  /**
   * IntersectionObserver `rootMargin` for the chunk sentinel — how far ahead
   * of the viewport bottom to trigger loading the next chunk. Default `800px`.
   */
  chunkRootMargin?: string;
  /**
   * When true, items become clickable triggers for the `<Lightbox />`
   * component (which must be placed once on the page).
   */
  lightbox?: boolean;
  class?: string;
}

const {
  images,
  targetRowHeight = 240,
  gap = 6,
  maxRowHeight,
  chunkSize,
  chunkRootMargin = "800px",
  lightbox = false,
  class: className,
} = Astro.props;

const chunked = chunkSize != null && chunkSize > 0 && chunkSize < images.length;
---

<div
  class:list={["ajg-root", className]}
  data-target-row-height={targetRowHeight}
  data-gap={gap}
  data-max-row-height={maxRowHeight ?? ""}
  data-chunk-size={chunked ? chunkSize : ""}
  data-chunk-root-margin={chunked ? chunkRootMargin : ""}
  data-lightbox={lightbox ? "1" : ""}
  style={`--ajg-gap: ${gap}px; --ajg-target-row-height: ${targetRowHeight}px;`}
>
  {
    images.map(({ src, alt, caption, href, preview }) => (
      <div
        class="ajg-item"
        data-w={src.width}
        data-h={src.height}
        style={preview ? `background-image:url(${preview})` : undefined}
      >
        {href ? (
          <a class="ajg-link" href={href}>
            <Image
              src={src}
              alt={alt ?? ""}
              loading="lazy"
              decoding="async"
              data-preview={preview}
            />
            {caption && <div class="ajg-caption" set:html={caption} />}
          </a>
        ) : (
          <>
            <Image
              src={src}
              alt={alt ?? ""}
              loading="lazy"
              decoding="async"
              data-preview={preview}
            />
            {caption && <div class="ajg-caption" set:html={caption} />}
          </>
        )}
      </div>
    ))
  }
  {chunked && <div class="ajg-sentinel" aria-hidden="true" />}
</div>

<style>
  .ajg-root {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ajg-gap, 6px);
  }
  .ajg-root.ajg-ready {
    display: block;
    position: relative;
  }
  .ajg-item {
    flex: 0 0 auto;
    height: var(--ajg-target-row-height, 240px);
    overflow: hidden;
    background-color: color-mix(in srgb, currentColor 8%, transparent);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .ajg-item :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ajg-root.ajg-ready .ajg-item {
    position: absolute;
    top: 0;
    left: 0;
    height: auto;
  }
  .ajg-sentinel {
    display: none;
  }
  .ajg-root.ajg-ready .ajg-sentinel {
    display: block;
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    pointer-events: none;
  }
  .ajg-link {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .ajg-root[data-lightbox="1"] .ajg-item {
    cursor: zoom-in;
  }
  .ajg-caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.6rem 0.7rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.75));
    color: #fff;
    font-size: 0.75rem;
    line-height: 1.35;
    opacity: 0;
    transform: translateY(20%);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
    pointer-events: none;
  }
  .ajg-caption :global(a) {
    pointer-events: auto;
  }
  .ajg-caption :global(.ajg-title) {
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 0.15rem;
  }
  .ajg-caption :global(.ajg-tech) {
    opacity: 0.85;
    font-variant-numeric: tabular-nums;
  }
  .ajg-caption :global(.ajg-meta) {
    opacity: 0.7;
    font-size: 0.7rem;
  }
  .ajg-caption :global(.ajg-keywords) {
    margin-top: 0.3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .ajg-caption :global(.ajg-keyword) {
    background: rgba(255, 255, 255, 0.18);
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    font-size: 0.65rem;
    line-height: 1.4;
  }
  .ajg-item:hover .ajg-caption,
  .ajg-item:focus-within .ajg-caption {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  import { computeLayout } from "./index.js";

  type Root = HTMLElement & { __ajgCleanup?: () => void };

  function readNumber(el: HTMLElement, attr: string, fallback?: number) {
    const raw = el.dataset[attr];
    if (raw == null || raw === "") return fallback;
    const n = Number(raw);
    return Number.isFinite(n) ? n : fallback;
  }

  function layout(
    root: Root,
    items: HTMLElement[],
    sentinel: HTMLElement | null,
    visibleCount: number,
  ) {
    if (!items.length) {
      root.style.height = "0px";
      root.classList.add("ajg-ready");
      return;
    }
    const containerWidth = root.clientWidth;
    if (containerWidth <= 0) return;

    const visible = items.slice(0, visibleCount);
    const dims = visible.map((el) => ({
      w: Number(el.dataset.w) || 1,
      h: Number(el.dataset.h) || 1,
    }));

    const targetRowHeight = readNumber(root, "targetRowHeight", 240)!;
    const gap = readNumber(root, "gap", 6)!;
    const maxRowHeight = readNumber(root, "maxRowHeight");

    const { boxes, totalHeight } = computeLayout(dims, {
      containerWidth,
      targetRowHeight,
      gap,
      ...(maxRowHeight != null ? { maxRowHeight } : {}),
    });

    root.style.height = `${totalHeight}px`;

    visible.forEach((el, i) => {
      const box = boxes[i];
      el.style.display = "";
      el.style.left = `${box.left}px`;
      el.style.top = `${box.top}px`;
      el.style.width = `${box.width}px`;
      el.style.height = `${box.height}px`;
    });
    for (let i = visibleCount; i < items.length; i++) {
      items[i].style.display = "none";
    }

    if (sentinel) {
      sentinel.style.top = `${Math.max(0, totalHeight - 1)}px`;
    }

    root.classList.add("ajg-ready");
  }

  function init(root: Root) {
    if (root.__ajgCleanup) return;

    const items = Array.from(
      root.querySelectorAll<HTMLElement>(".ajg-item"),
    );
    const sentinel = root.querySelector<HTMLElement>(".ajg-sentinel");
    const chunkSize = readNumber(root, "chunkSize");
    const rootMargin = root.dataset.chunkRootMargin || "800px";

    let visibleCount =
      chunkSize && chunkSize > 0
        ? Math.min(chunkSize, items.length)
        : items.length;

    let raf = 0;
    const schedule = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        layout(root, items, sentinel, visibleCount);
      });
    };

    layout(root, items, sentinel, visibleCount);

    const ro = new ResizeObserver(schedule);
    ro.observe(root);

    const onRelayout = () => schedule();
    root.addEventListener("ajg:relayout", onRelayout);

    let io: IntersectionObserver | null = null;
    if (sentinel && chunkSize && visibleCount < items.length) {
      io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          visibleCount = Math.min(visibleCount + chunkSize, items.length);
          schedule();
          if (visibleCount >= items.length) {
            io?.disconnect();
            io = null;
          }
        },
        { rootMargin },
      );
      io.observe(sentinel);
    }

    root.__ajgCleanup = () => {
      ro.disconnect();
      io?.disconnect();
      root.removeEventListener("ajg:relayout", onRelayout);
      if (raf) cancelAnimationFrame(raf);
    };
  }

  function bootstrap() {
    const roots = document.querySelectorAll<Root>(".ajg-root");
    roots.forEach(init);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootstrap, { once: true });
  } else {
    bootstrap();
  }

  document.addEventListener("astro:page-load", bootstrap);
</script>
