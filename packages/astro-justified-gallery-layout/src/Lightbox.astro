---
/**
 * Drop-in modal lightbox for `<JustifiedGallery />` and
 * `<JustifiedGalleryVirtual />`.
 *
 * Usage: place once on the page, then opt in per gallery via `lightbox`:
 *
 *   <Lightbox />
 *   <JustifiedGallery images={images} lightbox />
 *
 * Behavior:
 *   - Click an item → opens the modal with that image
 *   - ←/→ arrows or swipe navigate within the same gallery
 *   - ESC, ×, or backdrop click to close
 *   - Static galleries can navigate every item (even ones hidden by chunkSize);
 *     virtual galleries navigate only items currently in the DOM (a few rows
 *     above/below the viewport).
 */
---

<dialog class="ajg-lb" aria-label="Image viewer">
  <button class="ajg-lb-close" type="button" aria-label="Close" data-ajg-lb-close>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 6 L18 18 M18 6 L6 18" />
    </svg>
  </button>
  <button class="ajg-lb-nav ajg-lb-prev" type="button" aria-label="Previous" data-ajg-lb-prev>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M15 5 L8 12 L15 19" />
    </svg>
  </button>
  <button class="ajg-lb-nav ajg-lb-next" type="button" aria-label="Next" data-ajg-lb-next>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M9 5 L16 12 L9 19" />
    </svg>
  </button>
  <img class="ajg-lb-img" alt="" />
</dialog>

<style is:global>
  dialog.ajg-lb {
    border: 0;
    padding: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    background: rgba(0, 0, 0, 0.92);
    color: #fff;
    overflow: hidden;
  }
  dialog.ajg-lb::backdrop {
    background: rgba(0, 0, 0, 0.92);
  }
  dialog.ajg-lb[open] {
    display: grid;
    grid-template-rows: 1fr;
    place-items: center;
  }
  .ajg-lb-img {
    max-width: calc(100vw - 1.5rem);
    max-height: calc(100vh - 1.5rem);
    object-fit: contain;
    display: block;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-drag: none;
  }
  .ajg-lb-img.ajg-lb-anim {
    transition: transform 220ms ease;
  }

  .ajg-lb-close,
  .ajg-lb-nav {
    position: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    z-index: 1;
    font-family: system-ui, -apple-system, sans-serif;
    transition: background 0.15s ease;
  }
  .ajg-lb-close:hover,
  .ajg-lb-nav:hover {
    background: rgba(0, 0, 0, 0.8);
  }
  .ajg-lb-close {
    top: 1rem;
    right: 1rem;
    width: 2.5rem;
    height: 2.5rem;
  }
  .ajg-lb-close svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .ajg-lb-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
  }
  .ajg-lb-nav svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .ajg-lb-close svg,
  .ajg-lb-nav svg {
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ajg-lb-prev {
    left: 1rem;
  }
  .ajg-lb-next {
    right: 1rem;
  }
  .ajg-lb[data-single="1"] .ajg-lb-nav {
    display: none;
  }
</style>

<script>
  type LbDialog = HTMLDialogElement & { __ajgLbInit?: boolean };
  const dialog = document.querySelector<LbDialog>("dialog.ajg-lb");
  if (dialog && !dialog.__ajgLbInit) {
    dialog.__ajgLbInit = true;
    init(dialog);
  }

  function init(dialog: LbDialog) {
    const img = dialog.querySelector<HTMLImageElement>(".ajg-lb-img")!;
    const closeBtn = dialog.querySelector<HTMLButtonElement>(
      "[data-ajg-lb-close]",
    )!;
    const prevBtn = dialog.querySelector<HTMLButtonElement>(
      "[data-ajg-lb-prev]",
    )!;
    const nextBtn = dialog.querySelector<HTMLButtonElement>(
      "[data-ajg-lb-next]",
    )!;

    let siblings: HTMLElement[] = [];
    let idx = 0;

    const itemSelector = ".ajg-item, .ajgv-item";
    const rootSelector = ".ajg-root, .ajgv-root";

    let savedBodyOverflow = "";
    let savedBodyPaddingRight = "";
    function lockScroll() {
      const sbWidth =
        window.innerWidth - document.documentElement.clientWidth;
      savedBodyOverflow = document.body.style.overflow;
      savedBodyPaddingRight = document.body.style.paddingRight;
      document.body.style.overflow = "hidden";
      if (sbWidth > 0) document.body.style.paddingRight = `${sbWidth}px`;
    }
    function unlockScroll() {
      document.body.style.overflow = savedBodyOverflow;
      document.body.style.paddingRight = savedBodyPaddingRight;
    }
    dialog.addEventListener("close", unlockScroll);

    async function open(item: HTMLElement) {
      const root = item.closest(rootSelector) as HTMLElement | null;
      if (!root) return;
      siblings = Array.from(
        root.querySelectorAll<HTMLElement>(itemSelector),
      ).filter((el) => el.querySelector("img"));
      const i = siblings.indexOf(item);
      if (i < 0) return;
      idx = i;
      dialog.dataset.single = siblings.length <= 1 ? "1" : "";
      animating = false;
      img.classList.remove("ajg-lb-anim");
      resetTransform();
      // Open the modal first so the dialog is in the document and the user
      // gets immediate feedback (backdrop), then swap content asynchronously.
      // setContent() hides the img while decoding, so the old bitmap from a
      // previous open won't flash through.
      if (!dialog.open) {
        lockScroll();
        dialog.showModal();
      }
      await setContent();
    }

    async function setContent() {
      const item = siblings[idx];
      if (!item) return;
      const sourceImg = item.querySelector<HTMLImageElement>("img");
      if (!sourceImg) return;

      // Two-phase load: paint a tiny LQIP preview instantly, then upgrade to
      // the high-resolution variant in the background. Eliminates blank/ghost
      // frames on open and on every navigate.

      img.alt = sourceImg.alt || "";

      // Phase 1: instant preview. Prefer the LQIP data URI (server-generated,
      // ~1–2 KB, decodes in <1ms) and fall back to whatever the gallery thumb
      // already loaded. With srcset cleared the browser uses exactly this URL.
      img.style.visibility = "hidden";
      img.removeAttribute("srcset");
      img.removeAttribute("sizes");
      const previewSrc =
        sourceImg.dataset.preview ||
        sourceImg.currentSrc ||
        sourceImg.src;
      if (previewSrc) img.src = previewSrc;
      try {
        await img.decode();
      } catch {}
      img.style.visibility = "";

      // Phase 2: upgrade to the high-resolution variant. The browser keeps
      // the preview painted while it fetches the larger one, then swaps it
      // in place — no flash, no blank.
      if (sourceImg.srcset) {
        img.srcset = sourceImg.srcset;
        img.sizes = "100vw";
      } else if (sourceImg.src && sourceImg.src !== previewSrc) {
        img.src = sourceImg.src;
      }
    }

    function resetTransform() {
      img.style.transform = "";
    }

    let animating = false;
    async function navigate(direction: 1 | -1) {
      if (siblings.length <= 1 || animating) return;
      animating = true;
      const distance = window.innerWidth;
      img.classList.add("ajg-lb-anim");
      img.style.transform = `translateX(${-direction * distance}px)`;
      await new Promise((r) => setTimeout(r, 220));
      idx = (idx + direction + siblings.length) % siblings.length;
      // setContent() hides the img during decode so the old bitmap doesn't
      // flash through during the slide-in.
      await setContent();
      // Jump to opposite side without transition, then animate back to center.
      img.classList.remove("ajg-lb-anim");
      img.style.transform = `translateX(${direction * distance}px)`;
      await new Promise((r) => requestAnimationFrame(() => r(undefined)));
      img.classList.add("ajg-lb-anim");
      img.style.transform = "translateX(0)";
      await new Promise((r) => setTimeout(r, 220));
      img.classList.remove("ajg-lb-anim");
      resetTransform();
      animating = false;
    }

    function next() {
      void navigate(1);
    }
    function prev() {
      void navigate(-1);
    }

    // Item click → open. Skip clicks on links (e.g. GPS link inside caption)
    // so they keep their normal navigation behavior.
    document.addEventListener("click", (ev) => {
      const target = ev.target as HTMLElement | null;
      if (!target) return;
      if (target.closest("a[href]")) return;
      const item = target.closest<HTMLElement>(itemSelector);
      if (!item) return;
      const root = item.closest<HTMLElement>(rootSelector);
      if (!root || root.dataset.lightbox !== "1") return;
      ev.preventDefault();
      void open(item);
    });

    closeBtn.addEventListener("click", () => dialog.close());
    prevBtn.addEventListener("click", prev);
    nextBtn.addEventListener("click", next);

    // Click on backdrop (the dialog itself, not its children) closes.
    dialog.addEventListener("click", (ev) => {
      if (ev.target === dialog) dialog.close();
    });

    // Touch / pointer swipe gestures on the image.
    const SWIPE_THRESHOLD = 60;
    let dragStartX: number | null = null;
    let dragStartY: number | null = null;
    let dragLocked: "x" | "y" | null = null;
    let activePointerId: number | null = null;

    img.addEventListener("pointerdown", (ev) => {
      if (animating) return;
      if (ev.pointerType === "mouse" && ev.button !== 0) return;
      dragStartX = ev.clientX;
      dragStartY = ev.clientY;
      dragLocked = null;
      activePointerId = ev.pointerId;
      img.classList.remove("ajg-lb-anim");
    });

    img.addEventListener("pointermove", (ev) => {
      if (dragStartX == null || ev.pointerId !== activePointerId) return;
      const dx = ev.clientX - dragStartX;
      const dy = ev.clientY - (dragStartY ?? 0);
      if (dragLocked == null) {
        if (Math.abs(dx) < 6 && Math.abs(dy) < 6) return;
        dragLocked = Math.abs(dx) > Math.abs(dy) ? "x" : "y";
        if (dragLocked === "x") {
          try {
            img.setPointerCapture(ev.pointerId);
          } catch {}
        }
      }
      if (dragLocked !== "x") return;
      ev.preventDefault();
      img.style.transform = `translateX(${dx}px)`;
    });

    function endDrag(ev: PointerEvent) {
      if (dragStartX == null || ev.pointerId !== activePointerId) return;
      const dx = ev.clientX - dragStartX;
      const wasHorizontal = dragLocked === "x";
      dragStartX = null;
      dragStartY = null;
      dragLocked = null;
      activePointerId = null;
      if (!wasHorizontal) {
        resetTransform();
        return;
      }
      if (Math.abs(dx) > SWIPE_THRESHOLD) {
        // Treat the in-progress drag as the slide-out half of navigate().
        animating = true;
        const distance = window.innerWidth;
        img.classList.add("ajg-lb-anim");
        img.style.transform = `translateX(${dx > 0 ? distance : -distance}px)`;
        setTimeout(() => {
          const dir = (dx > 0 ? -1 : 1) as 1 | -1;
          idx = (idx + dir + siblings.length) % siblings.length;
          setContent();
          img.classList.remove("ajg-lb-anim");
          img.style.transform = `translateX(${dir * distance}px)`;
          requestAnimationFrame(() => {
            img.classList.add("ajg-lb-anim");
            img.style.transform = "translateX(0)";
            setTimeout(() => {
              img.classList.remove("ajg-lb-anim");
              resetTransform();
              animating = false;
            }, 220);
          });
        }, 200);
      } else {
        // Snap back to center.
        img.classList.add("ajg-lb-anim");
        img.style.transform = "translateX(0)";
        setTimeout(() => {
          img.classList.remove("ajg-lb-anim");
          resetTransform();
        }, 220);
      }
    }
    img.addEventListener("pointerup", endDrag);
    img.addEventListener("pointercancel", endDrag);

    // Keyboard nav (ESC handled natively by <dialog>).
    document.addEventListener("keydown", (ev) => {
      if (!dialog.open) return;
      if (ev.key === "ArrowLeft") {
        ev.preventDefault();
        prev();
      } else if (ev.key === "ArrowRight") {
        ev.preventDefault();
        next();
      }
    });
  }
</script>
